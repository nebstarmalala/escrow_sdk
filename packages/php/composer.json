{
  "name": "aminitrust/escrow-sdk",
  "description": "Server-side client for the Escrow Partner API - hold funds in escrow from your own checkout.",
  "type": "library",
  "license": "MIT",
  "keywords": ["escrow", "payments", "mpesa", "kenya", "marketplace", "webhooks"],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "php-http/discovery": "^1.19"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.1",
    "guzzlehttp/guzzle": "^7.8",
    "nyholm/psr7": "^1.8"
  },
  "autoload": {
    "psr-4": {
      "Aminitrust\\Escrow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aminitrust\\Escrow\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
