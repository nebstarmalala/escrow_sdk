{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Resolved against the local source rather than a published package, so
    // this example is typechecked in CI. An example that does not compile is
    // worse than no example: it is a confident-looking wrong answer.
    "baseUrl": ".",
    "paths": {
      "@aminitrust/escrow-sdk": ["../../packages/typescript/src/index.ts"]
    },
    // The example has no node_modules of its own; @types/node comes from the
    // package it demonstrates.
    "typeRoots": ["../../packages/typescript/node_modules/@types"]
  },
  "include": ["*.ts"]
}
